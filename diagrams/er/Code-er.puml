@startuml
title SmartHome ER Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

class Gateway {
  +User userInfo
  +Home homeInfo
  +List<Scenario> scenarios
  +List<Device> devices
}

class User {
  +String name
  +String home_id
}

class Scenario {
  +String id
  +String name
  +Time dt_create
  +Time dt_cpdate
  +List<Module> modules
}

class Home {
  +String name
  +List<Room> rooms
  +List<Scenario> scenarios
}

class Device {
  +String name
  +DeviceType type_id
  +String serial_number
  +TelemetryData params
  +String status
}

class LighterSystem {
  +String id
  +String name
  +String value
}

class TemperatureSystem {
  +String id
  +String name
  +String value
}

class SensorSystem {
  +String id
  +String name
  +String value
}

Gateway "1" -- "1" User : has
Gateway "1" -- "1" Home : has
Gateway "1" -- "0..*" Device : has
Gateway "1" -- "0..*" Scenario : includes
Gateway "1" -- "0..*" TemperatureSystem : includes
Gateway "1" -- "0..*" LighterSystem : includes
Gateway "1" -- "0..*" SensorSystem : includes

Scenario "1" -- "1" TemperatureSystem : has
Scenario "1" -- "1" LighterSystem : has
Scenario "1" -- "1" SensorSystem : has
Scenario "1" -- "1" Home : has
Scenario "1" -- "0..*" Device : includes

@enduml