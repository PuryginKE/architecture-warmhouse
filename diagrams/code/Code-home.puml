@startuml
title SmartHome Home Management Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

class Home {
  +String name
  +List<Room> rooms
  +List<Scenario> scenarios
  +void createRoom()
  +void getState()
  +void activate()
  +void cancel()
  +void getSensor()
  +void setSensor()
  +void getTemperature()
  +void setLighter()
}

class Room {
  +String location
  +String temperature
  +String lighting
  +List<Scenario> scenarios
  +void getState()
  +void activate()
  +void cancel()
  +void getSensor()
  +void setSensor()
  +void getTemperature()
  +void setLighter()
}

@enduml