@startuml
title SmartHome Scenario Management Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

class Scenario {
  +String id
  +String name
  +Time dt_create
  +Time dt_update
  +String status
  +List<Module> modules
  +void getScenario()
  +void setScenario()
}

class Module {
  +String id
  +String name
  +String status
  +String value
  +String description
  +String location
  +Time dt_create 
  +List<Device> devices
}

class Device {
  +String id
  +String name
  +DeviceType type_id
  +String serial_number
  +TelemetryData params
  +String status
}

Scenario "1" -- "0..*" Module : includes
Module "1" -- "0..*" Device : includes

@enduml